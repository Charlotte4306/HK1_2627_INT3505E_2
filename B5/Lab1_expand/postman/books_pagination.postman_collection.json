	"item": [
		{
			"name": "Offset - trang 1",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200 + strategy offset', () => {",
							"  pm.response.to.have.status(200);",
							"  const p = pm.response.json().pagination;",
							"  pm.expect(p.strategy).to.eql('offset');",
							"  pm.expect(p.has_next).to.be.true;",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}?strategy=offset&offset=0&limit=3",
					"host": [
						"{{baseUrl}}"
					],
					"query": [
						{
							"key": "strategy",
							"value": "offset"
						},
						{
							"key": "offset",
							"value": "0"
						},
						{
							"key": "limit",
							"value": "3"
						}
					]
				}
			},
			"response": []
		},
