		{
			"name": "Cursor - trang đầu",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const p = pm.response.json().pagination;",
							"pm.test('có next_cursor', () => pm.expect(p.next_cursor).to.be.a('string'));",
							"pm.collectionVariables.set('next_cursor', p.next_cursor || '');"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}?strategy=cursor&limit=3&sort=-price,title",
					"host": [
						"{{baseUrl}}"
					],
					"query": [
						{
							"key": "strategy",
							"value": "cursor"
						},
						{
							"key": "limit",
							"value": "3"
						},
						{
							"key": "sort",
							"value": "-price,title"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Cursor - trang tiếp (dùng next_cursor)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200', () => pm.response.to.have.status(200));",
							"pm.collectionVariables.set('next_cursor', pm.response.json().pagination.next_cursor || '');"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}?strategy=cursor&limit=3&sort=-price,title&cursor={{next_cursor}}",
